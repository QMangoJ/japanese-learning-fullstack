# Copy to .dev.vars (gitignored) for local Google sign-in.
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web application)
# Authorized JavaScript origins:
#   http://localhost:5173
#   https://YOUR_WORKER.workers.dev
# Authorized redirect URIs:
#   http://localhost:5173/auth/google/callback
#   https://YOUR_WORKER.workers.dev/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Long random string used to sign session cookies:
#   openssl rand -hex 32
SESSION_SECRET=
# Optional: notify when the learner adds a manual 错题本 note (word/grammar).
# When unset, the worker skips the webhook (saving still succeeds).
# MISTAKE_NOTIFY_WEBHOOK_URL=https://example.com/hooks/mistake-manual
# MISTAKE_NOTIFY_WEBHOOK_KEY=long-random-shared-secret
