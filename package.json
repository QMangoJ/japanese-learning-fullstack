		"react-router": "7.9.6"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.15.3",
		"@playwright/test": "^1.62.1",
		"@react-router/dev": "7.9.6",
		"@tailwindcss/vite": "4.1.17",
		"@types/node": "24.10.1",
		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.3",
		"tailwindcss": "4.1.17",
