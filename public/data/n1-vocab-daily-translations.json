{
 "version": 1,
 "vocab": {
  "w1d1": {
   "items": [
    {
     "n": 1,
     "translation": "我丈夫花钱非常大手大脚。"
    },
    {
     "n": 2,
     "translation": "他在时间上有点散漫。"
    },
    {
     "n": 3,
     "translation": "她虽然是大明星，却是个非常坦率随和的人。"
    },
    {
     "n": 4,
     "translation": "豪华而有气派、光彩夺目的宝石。"
    },
    {
     "n": 5,
     "translation": "太贪财的人会被讨厌。"
    },
    {
     "n": 6,
     "translation": "那个店员对谁都和蔼可亲。"
    },
    {
     "n": 7,
     "translation": "她是前途有望的新人女演员。"
    },
    {
     "n": 8,
     "translation": "他有着健壮的身体。"
    }
   ]
  },
  "w1d2": {
   "items": [
    {
     "n": 1,
     "translation": "差点没赶上电车，很着急。"
    },
    {
     "n": 2,
     "translation": "山田老师一生气就非常可怕哦。"
    },
    {
     "n": 3,
     "translation": "非常盼望去旅行的日子。"
    },
    {
     "n": 4,
     "translation": "顾虑邻居，没法练习乐器。"
    },
    {
     "n": 5,
     "translation": "梅雨季节总是下雨，令人郁闷。"
    },
    {
     "n": 6,
     "translation": "这么简单的问题都做错了，真是太丢人了。"
    },
    {
     "n": 7,
     "translation": "这台电脑不需要麻烦的布线。"
    },
    {
     "n": 8,
     "translation": "他才是适合当总统的人物。"
    }
   ]
  },
  "w1d3": {
   "items": [
    {
     "n": 1,
     "translation": "好好泡在热水里，泡到肩膀吧。"
    },
    {
     "n": 2,
     "translation": "为了避开窜到车前的猫，结果撞上了电线杆。"
    },
    {
     "n": 3,
     "translation": "不能从道口的栏杆下面钻过去。"
    },
    {
     "n": 4,
     "translation": "那是我小时候经常哼的歌。"
    },
    {
     "n": 5,
     "translation": "用海苔把米饭包起来吃。"
    },
    {
     "n": 6,
     "translation": "被批评的学生低着头哭了。"
    },
    {
     "n": 7,
     "translation": "累了，可以在沙发上躺一会儿吗？"
    },
    {
     "n": 8,
     "translation": "假日里摆弄庭院是我的爱好。"
    }
   ]
  },
  "w1d4": {
   "items": [
    {
     "n": 1,
     "translation": "我家的狗最亲近妈妈。"
    },
    {
     "n": 2,
     "translation": "和教练闹翻的那名选手，最终被迫退出了。"
    },
    {
     "n": 3,
     "translation": "谁都不袒护我。"
    },
    {
     "n": 4,
     "translation": "她对丈夫尽心尽力。"
    },
    {
     "n": 5,
     "translation": "这部漫画的主人公最后终于收拾了坏人。"
    },
    {
     "n": 6,
     "translation": "他是被父母娇生惯养长大的。"
    },
    {
     "n": 7,
     "translation": "恶作剧被人向老师告了状。"
    },
    {
     "n": 8,
     "translation": "感冒加重，闹到了住院的地步。"
    }
   ]
  },
  "w1d5": {
   "items": [
    {
     "n": 1,
     "translation": "浴室里长霉了。"
    },
    {
     "n": 2,
     "translation": "请不要给猴子喂食。"
    },
    {
     "n": 3,
     "translation": "用窗帘挡住了光线。"
    },
    {
     "n": 4,
     "translation": "请把切好的洋葱用水泡一下。"
    },
    {
     "n": 5,
     "translation": "因为太热，把系着的领带松开了。"
    },
    {
     "n": 6,
     "translation": "手一滑，爆米花撒了一地。"
    },
    {
     "n": 7,
     "translation": "眼看要吵起来，赶紧岔开了话题。"
    },
    {
     "n": 8,
     "translation": "我违背了和他定下的约定。"
    }
   ]
  },
  "w1d6": {
   "items": [
    {
     "n": 1,
     "translation": "妈妈去医院，我必须陪着。"
    },
    {
     "n": 2,
     "translation": "鱼刺卡在喉咙里了。"
    },
    {
     "n": 3,
     "translation": "因为中暑，意识模糊不清。"
    },
    {
     "n": 4,
     "translation": "被虫子叮的手指肿成了这样。"
    },
    {
     "n": 5,
     "translation": "也许是累了，眼睛发花看不清楚。"
    },
    {
     "n": 6,
     "translation": "吃了药以后，疼痛缓解了不少。"
    },
    {
     "n": 7,
     "translation": "饿得头晕眼花。"
    },
    {
     "n": 8,
     "translation": "病情加速恶化，他终于陷入了昏迷。"
    }
   ]
  }
 }
}