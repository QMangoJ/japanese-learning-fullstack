{
 "version": 1,
 "vocab": {
  "w1d1": {
   "items": [
    {
     "n": 1,
     "translation": "我丈夫花钱非常大手大脚。"
    },
    {
     "n": 2,
     "translation": "他在时间上有点散漫。"
    },
    {
     "n": 3,
     "translation": "她虽然是大明星，却是个非常坦率随和的人。"
    },
    {
     "n": 4,
     "translation": "豪华而有气派、光彩夺目的宝石。"
    },
    {
     "n": 5,
     "translation": "太贪财的人会被讨厌。"
    },
    {
     "n": 6,
     "translation": "那个店员对谁都和蔼可亲。"
    },
    {
     "n": 7,
     "translation": "她是前途有望的新人女演员。"
    },
    {
     "n": 8,
     "translation": "他有着健壮的身体。"
    }
   ]
  },
  "w1d2": {
   "items": [
    {
     "n": 1,
     "translation": "差点没赶上电车，很着急。"
    },
    {
     "n": 2,
     "translation": "山田老师一生气就非常可怕哦。"
    },
    {
     "n": 3,
     "translation": "非常盼望去旅行的日子。"
    },
    {
     "n": 4,
     "translation": "顾虑邻居，没法练习乐器。"
    },
    {
     "n": 5,
     "translation": "梅雨季节总是下雨，令人郁闷。"
    },
    {
     "n": 6,
     "translation": "这么简单的问题都做错了，真是太丢人了。"
    },
    {
     "n": 7,
     "translation": "这台电脑不需要麻烦的布线。"
    },
    {
     "n": 8,
     "translation": "他才是适合当总统的人物。"
    }
   ]
  },
  "w1d3": {
   "items": [
    {
     "n": 1,
     "translation": "好好泡在热水里，泡到肩膀吧。"
    },
    {
     "n": 2,
     "translation": "为了避开窜到车前的猫，结果撞上了电线杆。"
    },
    {
     "n": 3,
     "translation": "不能从道口的栏杆下面钻过去。"
    },
    {
     "n": 4,
     "translation": "那是我小时候经常哼的歌。"
    },
    {
     "n": 5,
     "translation": "用海苔把米饭包起来吃。"
    },
    {
     "n": 6,
     "translation": "被批评的学生低着头哭了。"
    },
    {
     "n": 7,
     "translation": "累了，可以在沙发上躺一会儿吗？"
    },
    {
     "n": 8,
     "translation": "假日里摆弄庭院是我的爱好。"
    }
   ]
  },
  "w1d4": {
   "items": [
    {
     "n": 1,
     "translation": "我家的狗最亲近妈妈。"
    },
    {
     "n": 2,
     "translation": "和教练闹翻的那名选手，最终被迫退出了。"
    },
    {
     "n": 3,
     "translation": "谁都不袒护我。"
    },
    {
     "n": 4,
     "translation": "她对丈夫尽心尽力。"
    },
    {
     "n": 5,
     "translation": "这部漫画的主人公最后终于收拾了坏人。"
    },
    {
     "n": 6,
     "translation": "他是被父母娇生惯养长大的。"
    },
    {
     "n": 7,
     "translation": "恶作剧被人向老师告了状。"
    },
    {
     "n": 8,
     "translation": "感冒加重，闹到了住院的地步。"
    }
   ]
  },
  "w1d5": {
   "items": [
    {
     "n": 1,
     "translation": "浴室里长霉了。"
    },
    {
     "n": 2,
     "translation": "请不要给猴子喂食。"
    },
    {
     "n": 3,
     "translation": "用窗帘挡住了光线。"
    },
    {
     "n": 4,
     "translation": "请把切好的洋葱用水泡一下。"
    },
    {
     "n": 5,
     "translation": "因为太热，把系着的领带松开了。"
    },
    {
     "n": 6,
     "translation": "手一滑，爆米花撒了一地。"
    },
    {
     "n": 7,
     "translation": "眼看要吵起来，赶紧岔开了话题。"
    },
    {
     "n": 8,
     "translation": "我违背了和他定下的约定。"
    }
   ]
  },
  "w1d6": {
   "items": [
    {
     "n": 1,
     "translation": "妈妈去医院，我必须陪着。"
    },
    {
     "n": 2,
     "translation": "鱼刺卡在喉咙里了。"
    },
    {
     "n": 3,
     "translation": "因为中暑，意识模糊不清。"
    },
    {
     "n": 4,
     "translation": "被虫子叮的手指肿成了这样。"
    },
    {
     "n": 5,
     "translation": "也许是累了，眼睛发花看不清楚。"
    },
    {
     "n": 6,
     "translation": "吃了药以后，疼痛缓解了不少。"
    },
    {
     "n": 7,
     "translation": "饿得头晕眼花。"
    },
    {
     "n": 8,
     "translation": "病情加速恶化，他终于陷入了昏迷。"
    }
   ]
  },
  "w2d1": {
   "items": [
    {
     "n": 1,
     "translation": "在车站换乘电车时不知所措。"
    },
    {
     "n": 2,
     "translation": "焦点没对上的模糊照片。"
    },
    {
     "n": 3,
     "translation": "他自以为很有才能。"
    },
    {
     "n": 4,
     "translation": "那座建筑的构造相当讲究。"
    },
    {
     "n": 5,
     "translation": "等了1个小时公交车还没来，等累了。"
    },
    {
     "n": 6,
     "translation": "他为自己的失败而叹息。"
    },
    {
     "n": 7,
     "translation": "梦想成真，成为了职业棒球选手！"
    },
    {
     "n": 8,
     "translation": "少年谎报年龄买了香烟。"
    }
   ]
  },
  "w2d2": {
   "items": [
    {
     "n": 1,
     "translation": "最近好像流行尖头鞋。"
    },
    {
     "n": 2,
     "translation": "门嘎吱嘎吱地响，很吵。"
    },
    {
     "n": 3,
     "translation": "这道炖菜里的牛肉软得像要化了，非常好吃。"
    },
    {
     "n": 4,
     "translation": "妈妈帮我把破了洞的袜子补好了。"
    },
    {
     "n": 5,
     "translation": "挥了球棒，但球只是擦了一下，没有飞出去。"
    },
    {
     "n": 6,
     "translation": "也许是眼镜度数不合适，字模模糊糊看不清楚。"
    },
    {
     "n": 7,
     "translation": "这块布经过了防水加工。"
    },
    {
     "n": 8,
     "translation": "因为蛀牙，脸肿了。"
    }
   ]
  },
  "w2d3": {
   "items": [
    {
     "n": 1,
     "translation": "他的名次颠覆了周围人的预测，最终是第3名。"
    },
    {
     "n": 2,
     "translation": "婚礼致辞中，千篇一律的客套话一个接一个。"
    },
    {
     "n": 3,
     "translation": "如果左右平衡的话，应该能笔直前进。"
    },
    {
     "n": 4,
     "translation": "他好像是靠吃山里的野草和树果熬过了饥饿。"
    },
    {
     "n": 5,
     "translation": "那一瞬间，云层断开，阳光照了下来。"
    },
    {
     "n": 6,
     "translation": "出轨被妻子发现了。"
    },
    {
     "n": 7,
     "translation": "被醉汉纠缠，打起架来了。"
    },
    {
     "n": 8,
     "translation": "那个村子的人口不断减少，最终连小学也没有了。"
    }
   ]
  },
  "w2d4": {
   "items": [
    {
     "n": 1,
     "translation": "那位演员上了年纪以后，演技变得非常沉稳老练。"
    },
    {
     "n": 2,
     "translation": "那名足球选手用娴熟的技术让观众着迷。"
    },
    {
     "n": 3,
     "translation": "开局明明很顺利，最后却精疲力尽，落到了最后一名。"
    },
    {
     "n": 4,
     "translation": "她总是戴着华丽耀眼的首饰。"
    },
    {
     "n": 5,
     "translation": "为顾客提供细致周到的服务。"
    },
    {
     "n": 6,
     "translation": "经济正在缓慢恢复。"
    },
    {
     "n": 7,
     "translation": "派对在和睦的气氛中进行着。"
    },
    {
     "n": 8,
     "translation": "夫妻和睦，过着幸福的生活。"
    }
   ]
  },
  "w2d5": {
   "items": [
    {
     "n": 1,
     "translation": "开车兜风前仔细检查了车。"
    },
    {
     "n": 2,
     "translation": "虽说是独栋房子，其实是只有两个房间的小房子。"
    },
    {
     "n": 3,
     "translation": "养育孩子绝不是件容易的事。"
    },
    {
     "n": 4,
     "translation": "电话里传来了令人毛骨悚然的声音。"
    },
    {
     "n": 5,
     "translation": "太难看了，别在电车里化妆。"
    },
    {
     "n": 6,
     "translation": "出生一周就会死去的、生命短暂的虫子。"
    },
    {
     "n": 7,
     "translation": "我向朋友借钱，结果对方露骨地表现出不情愿。"
    },
    {
     "n": 8,
     "translation": "警察查明了骗子恶毒的手法。"
    }
   ]
  },
  "w2d6": {
   "items": [
    {
     "n": 1,
     "translation": "大部分人都赞成他的意见。"
    },
    {
     "n": 2,
     "translation": "这次价格大幅下调了。"
    },
    {
     "n": 3,
     "translation": "我坚决反对提高消费税。"
    },
    {
     "n": 4,
     "translation": "电脑在这10年里取得了惊人的进步。"
    },
    {
     "n": 5,
     "translation": "这一带到处都有便利店。"
    },
    {
     "n": 6,
     "translation": "糖稍微多放一点会更好吃。"
    },
    {
     "n": 7,
     "translation": "吵嘴的话，妻子压倒性地占上风。"
    },
    {
     "n": 8,
     "translation": "无论什么情况都可以来商量。"
    }
   ]
  },
  "w3d1": {
   "items": [
    {
     "n": 1,
     "translation": "连续下雨，房间里湿漉漉的。"
    },
    {
     "n": 2,
     "translation": "狗对着食物，口水直流。"
    },
    {
     "n": 3,
     "translation": "运费因运输公司而各不相同。"
    },
    {
     "n": 4,
     "translation": "蝴蝶在原野上翩翩飞舞。"
    },
    {
     "n": 5,
     "translation": "把零散的拼图拼好完成了。"
    },
    {
     "n": 6,
     "translation": "想能流利地读日语。"
    },
    {
     "n": 7,
     "translation": "合同没谈成，上司肯定会大发雷霆吧。"
    },
    {
     "n": 8,
     "translation": "原以为他一定会当选，他落选了实在是非常遗憾。"
    }
   ]
  },
  "w3d2": {
   "items": [
    {
     "n": 1,
     "translation": "他到处搬家。"
    },
    {
     "n": 2,
     "translation": "我时常来这家拉面店。"
    },
    {
     "n": 3,
     "translation": "对已经过去的事一直耿耿于怀也没用。"
    },
    {
     "n": 4,
     "translation": "想买那款热门游戏软件，到处找了，但哪里都卖光了。"
    },
    {
     "n": 5,
     "translation": "这份报告虽然有些地方写错了字，但内容很好。"
    },
    {
     "n": 6,
     "translation": "她虽然发着牢骚，还是勉勉强强地帮我干了活。"
    },
    {
     "n": 7,
     "translation": "现在去车站的话，能从容赶上10点的电车吧。"
    },
    {
     "n": 8,
     "translation": "他在一点一点地攒买房的钱。"
    }
   ]
  },
  "w3d3": {
   "items": [
    {
     "n": 1,
     "translation": "我一直以为「たばこ」这个词肯定是日语，原来不是啊。"
    },
    {
     "n": 2,
     "translation": "他爽快地承认了那是自己犯的罪。"
    },
    {
     "n": 3,
     "translation": "在灯光照射下，东京塔在夜空中清晰地浮现出来。"
    },
    {
     "n": 4,
     "translation": "她迅速站起来，把座位让给了老人。"
    },
    {
     "n": 5,
     "translation": "完全不懂新手机的用法。"
    },
    {
     "n": 6,
     "translation": "从今天起我坚决戒酒。"
    },
    {
     "n": 7,
     "translation": "玩完以后要把玩具收拾整齐。"
    },
    {
     "n": 8,
     "translation": "运动后出了一身大汗。"
    }
   ]
  },
  "w3d4": {
   "items": [
    {
     "n": 1,
     "translation": "她睡得很熟，一点也没有要醒的迹象。"
    },
    {
     "n": 2,
     "translation": "我至今还在用盒式录音机。"
    },
    {
     "n": 3,
     "translation": "虽然是新型号，价格并没有那么贵哦。"
    },
    {
     "n": 4,
     "translation": "刚开始会觉得别扭，但很快就会习惯的。"
    },
    {
     "n": 5,
     "translation": "妻子一天到晚都在发牢骚。"
    },
    {
     "n": 6,
     "translation": "突然被人从后面叫住，吓了一跳。"
    },
    {
     "n": 7,
     "translation": "最近的高中生手机片刻不离手。"
    },
    {
     "n": 8,
     "translation": "时隔30年回母校一看，曾经是校园的地方建起了一座大公寓。"
    }
   ]
  },
  "w3d5": {
   "items": [
    {
     "n": 1,
     "translation": "这个杯面比那边的拉面店好吃多了。"
    },
    {
     "n": 2,
     "translation": "他虽然什么都没说，但一脸很不情愿的样子。"
    },
    {
     "n": 3,
     "translation": "挠了被虫子叮的地方，结果更痒了。"
    },
    {
     "n": 4,
     "translation": "那位老奶奶年轻时想必是个美人吧。"
    },
    {
     "n": 5,
     "translation": "今天外面特别冷。"
    },
    {
     "n": 6,
     "translation": "头狠狠地撞在了架子角上。"
    },
    {
     "n": 7,
     "translation": "考题非常难，完全不会。"
    },
    {
     "n": 8,
     "translation": "上了年纪也能保持健康，这比什么都好啊。"
    }
   ]
  },
  "w3d6": {
   "items": [
    {
     "n": 1,
     "translation": "本以为他们夫妻和睦，看样子他们好像离婚了。"
    },
    {
     "n": 2,
     "translation": "即使做了手术，他恐怕也救不过来吧。"
    },
    {
     "n": 3,
     "translation": "咦，奇怪。说不定走错路了。"
    },
    {
     "n": 4,
     "translation": "队伍勉强通过了预选。"
    },
    {
     "n": 5,
     "translation": "对待客人请尽量面带笑容。"
    },
    {
     "n": 6,
     "translation": "非常抱歉，那本书不巧已经没有库存了。"
    },
    {
     "n": 7,
     "translation": "这是用了大量时令蔬菜的菜肴。"
    },
    {
     "n": 8,
     "translation": "我提了好几个方案，但全都没被采纳。"
    }
   ]
  },
  "w4d1": {
   "items": [
    {
     "n": 1,
     "translation": "渐渐上了年纪，能分辨事物的好坏了。"
    },
    {
     "n": 2,
     "translation": "全体人员都同意了田中的意见。"
    },
    {
     "n": 3,
     "translation": "他虽然面不改色，但内心并不平静。"
    },
    {
     "n": 4,
     "translation": "这是在拍卖会上买到的二手冰箱。"
    },
    {
     "n": 5,
     "translation": "这台电脑又小又轻，可以轻松携带。"
    },
    {
     "n": 6,
     "translation": "我想不出这封邮件的发件人是谁。"
    },
    {
     "n": 7,
     "translation": "全家人分工打扫了整个房子。"
    },
    {
     "n": 8,
     "translation": "就算领了工资，要付的钱太多，手头也剩不下多少。"
    }
   ]
  },
  "w4d2": {
   "items": [
    {
     "n": 1,
     "translation": "他总是把麻烦的事往后推。"
    },
    {
     "n": 2,
     "translation": "他的出生地是青森。"
    },
    {
     "n": 3,
     "translation": "他沉迷于游戏，跟他说话也心不在焉。"
    },
    {
     "n": 4,
     "translation": "发生了火灾，消防车出动了。"
    },
    {
     "n": 5,
     "translation": "已经用酱油提前调好味了，只要烤一下马上就能吃。"
    },
    {
     "n": 6,
     "translation": "在没有人的公园里发生了火灾。"
    },
    {
     "n": 7,
     "translation": "对询问的答复终于到了。"
    },
    {
     "n": 8,
     "translation": "来，鼓足干劲加油吧！"
    }
   ]
  },
  "w4d3": {
   "items": [
    {
     "n": 1,
     "translation": "日本的少子老龄化正在加剧。"
    },
    {
     "n": 2,
     "translation": "所有人共同的愿望就是健康。"
    },
    {
     "n": 3,
     "translation": "政府发表了紧急声明。"
    },
    {
     "n": 4,
     "translation": "在车里可以不在意别人的目光大声唱歌。"
    },
    {
     "n": 5,
     "translation": "关于那件事，目前正在研究。"
    },
    {
     "n": 6,
     "translation": "我打算带头完成改革。"
    },
    {
     "n": 7,
     "translation": "住房贷款压得我家开支很紧张。"
    },
    {
     "n": 8,
     "translation": "那个女演员人气走在了实力前面啊。"
    }
   ]
  },
  "w4d4": {
   "items": [
    {
     "n": 1,
     "translation": "因为暴风雨，电车时刻表整天都很混乱。"
    },
    {
     "n": 2,
     "translation": "这是面向商家的，所以不零售。"
    },
    {
     "n": 3,
     "translation": "事已至此，就算赌气也要把它完成给你看。"
    },
    {
     "n": 4,
     "translation": "趁工作的间隙，顺路去了喜欢的咖啡店。"
    },
    {
     "n": 5,
     "translation": "因为下大雪，暂缓了外出。"
