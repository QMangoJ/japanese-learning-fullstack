{
 "version": 1,
 "vocab": {
  "w1d1": {
   "items": [
    {
     "n": 1,
     "translation": "我丈夫花钱非常大手大脚。"
    },
    {
     "n": 2,
     "translation": "他在时间上有点散漫。"
    },
    {
     "n": 3,
     "translation": "她虽然是大明星，却是个非常坦率随和的人。"
    },
    {
     "n": 4,
     "translation": "豪华而有气派、光彩夺目的宝石。"
    },
    {
     "n": 5,
     "translation": "太贪财的人会被讨厌。"
    },
    {
     "n": 6,
     "translation": "那个店员对谁都和蔼可亲。"
    },
    {
     "n": 7,
     "translation": "她是前途有望的新人女演员。"
    },
    {
     "n": 8,
     "translation": "他有着健壮的身体。"
    }
   ]
  },
  "w1d2": {
   "items": [
    {
     "n": 1,
     "translation": "差点没赶上电车，很着急。"
    },
    {
     "n": 2,
     "translation": "山田老师一生气就非常可怕哦。"
    },
    {
     "n": 3,
     "translation": "非常盼望去旅行的日子。"
    },
    {
     "n": 4,
     "translation": "顾虑邻居，没法练习乐器。"
    },
    {
     "n": 5,
     "translation": "梅雨季节总是下雨，令人郁闷。"
    },
    {
     "n": 6,
     "translation": "这么简单的问题都做错了，真是太丢人了。"
    },
    {
     "n": 7,
     "translation": "这台电脑不需要麻烦的布线。"
    },
    {
     "n": 8,
     "translation": "他才是适合当总统的人物。"
    }
   ]
  },
  "w1d3": {
   "items": [
    {
     "n": 1,
     "translation": "好好泡在热水里，泡到肩膀吧。"
    },
    {
     "n": 2,
     "translation": "为了避开窜到车前的猫，结果撞上了电线杆。"
    },
    {
     "n": 3,
     "translation": "不能从道口的栏杆下面钻过去。"
    },
    {
     "n": 4,
     "translation": "那是我小时候经常哼的歌。"
    },
    {
     "n": 5,
     "translation": "用海苔把米饭包起来吃。"
    },
    {
     "n": 6,
     "translation": "被批评的学生低着头哭了。"
    },
    {
     "n": 7,
     "translation": "累了，可以在沙发上躺一会儿吗？"
    },
    {
     "n": 8,
     "translation": "假日里摆弄庭院是我的爱好。"
    }
   ]
  },
  "w1d4": {
   "items": [
    {
     "n": 1,
     "translation": "我家的狗最亲近妈妈。"
    },
    {
     "n": 2,
     "translation": "和教练闹翻的那名选手，最终被迫退出了。"
    },
    {
     "n": 3,
     "translation": "谁都不袒护我。"
    },
    {
     "n": 4,
     "translation": "她对丈夫尽心尽力。"
    },
    {
     "n": 5,
     "translation": "这部漫画的主人公最后终于收拾了坏人。"
    },
    {
     "n": 6,
     "translation": "他是被父母娇生惯养长大的。"
    },
    {
     "n": 7,
     "translation": "恶作剧被人向老师告了状。"
    },
    {
     "n": 8,
     "translation": "感冒加重，闹到了住院的地步。"
    }
   ]
  },
  "w1d5": {
   "items": [
    {
     "n": 1,
     "translation": "浴室里长霉了。"
    },
    {
     "n": 2,
     "translation": "请不要给猴子喂食。"
    },
    {
     "n": 3,
     "translation": "用窗帘挡住了光线。"
    },
    {
     "n": 4,
     "translation": "请把切好的洋葱用水泡一下。"
    },
    {
     "n": 5,
     "translation": "因为太热，把系着的领带松开了。"
    },
    {
     "n": 6,
     "translation": "手一滑，爆米花撒了一地。"
    },
    {
     "n": 7,
     "translation": "眼看要吵起来，赶紧岔开了话题。"
    },
    {
     "n": 8,
     "translation": "我违背了和他定下的约定。"
    }
   ]
  },
  "w1d6": {
   "items": [
    {
     "n": 1,
     "translation": "妈妈去医院，我必须陪着。"
    },
    {
     "n": 2,
     "translation": "鱼刺卡在喉咙里了。"
    },
    {
     "n": 3,
     "translation": "因为中暑，意识模糊不清。"
    },
    {
     "n": 4,
     "translation": "被虫子叮的手指肿成了这样。"
    },
    {
     "n": 5,
     "translation": "也许是累了，眼睛发花看不清楚。"
    },
    {
     "n": 6,
     "translation": "吃了药以后，疼痛缓解了不少。"
    },
    {
     "n": 7,
     "translation": "饿得头晕眼花。"
    },
    {
     "n": 8,
     "translation": "病情加速恶化，他终于陷入了昏迷。"
    }
   ]
  },
  "w2d1": {
   "items": [
    {
     "n": 1,
     "translation": "在车站换乘电车时不知所措。"
    },
    {
     "n": 2,
     "translation": "焦点没对上的模糊照片。"
    },
    {
     "n": 3,
     "translation": "他自以为很有才能。"
    },
    {
     "n": 4,
     "translation": "那座建筑的构造相当讲究。"
    },
    {
     "n": 5,
     "translation": "等了1个小时公交车还没来，等累了。"
    },
    {
     "n": 6,
     "translation": "他为自己的失败而叹息。"
    },
    {
     "n": 7,
     "translation": "梦想成真，成为了职业棒球选手！"
    },
    {
     "n": 8,
     "translation": "少年谎报年龄买了香烟。"
    }
   ]
  },
  "w2d2": {
   "items": [
    {
     "n": 1,
     "translation": "最近好像流行尖头鞋。"
    },
    {
     "n": 2,
     "translation": "门嘎吱嘎吱地响，很吵。"
    },
    {
     "n": 3,
     "translation": "这道炖菜里的牛肉软得像要化了，非常好吃。"
    },
    {
     "n": 4,
     "translation": "妈妈帮我把破了洞的袜子补好了。"
    },
    {
     "n": 5,
     "translation": "挥了球棒，但球只是擦了一下，没有飞出去。"
    },
    {
     "n": 6,
     "translation": "也许是眼镜度数不合适，字模模糊糊看不清楚。"
    },
    {
     "n": 7,
     "translation": "这块布经过了防水加工。"
    },
    {
     "n": 8,
     "translation": "因为蛀牙，脸肿了。"
    }
   ]
  },
  "w2d3": {
   "items": [
    {
     "n": 1,
     "translation": "他的名次颠覆了周围人的预测，最终是第3名。"
    },
    {
     "n": 2,
     "translation": "婚礼致辞中，千篇一律的客套话一个接一个。"
    },
    {
     "n": 3,
     "translation": "如果左右平衡的话，应该能笔直前进。"
    },
    {
     "n": 4,
     "translation": "他好像是靠吃山里的野草和树果熬过了饥饿。"
    },
    {
     "n": 5,
     "translation": "那一瞬间，云层断开，阳光照了下来。"
    },
    {
     "n": 6,
     "translation": "出轨被妻子发现了。"
    },
    {
     "n": 7,
     "translation": "被醉汉纠缠，打起架来了。"
    },
    {
     "n": 8,
     "translation": "那个村子的人口不断减少，最终连小学也没有了。"
    }
   ]
  },
  "w2d4": {
   "items": [
    {
     "n": 1,
     "translation": "那位演员上了年纪以后，演技变得非常沉稳老练。"
    },
    {
     "n": 2,
     "translation": "那名足球选手用娴熟的技术让观众着迷。"
    },
    {
     "n": 3,
     "translation": "开局明明很顺利，最后却精疲力尽，落到了最后一名。"
    },
    {
     "n": 4,
     "translation": "她总是戴着华丽耀眼的首饰。"
    },
    {
     "n": 5,
     "translation": "为顾客提供细致周到的服务。"
    },
    {
     "n": 6,
     "translation": "经济正在缓慢恢复。"
    },
    {
     "n": 7,
     "translation": "派对在和睦的气氛中进行着。"
    },
    {
     "n": 8,
     "translation": "夫妻和睦，过着幸福的生活。"
    }
   ]
  },
  "w2d5": {
   "items": [
    {
     "n": 1,
     "translation": "开车兜风前仔细检查了车。"
    },
    {
     "n": 2,
     "translation": "虽说是独栋房子，其实是只有两个房间的小房子。"
    },
    {
     "n": 3,
     "translation": "养育孩子绝不是件容易的事。"
    },
    {
     "n": 4,
     "translation": "电话里传来了令人毛骨悚然的声音。"
    },
    {
     "n": 5,
     "translation": "太难看了，别在电车里化妆。"
    },
    {
     "n": 6,
     "translation": "出生一周就会死去的、生命短暂的虫子。"
    },
    {
     "n": 7,
     "translation": "我向朋友借钱，结果对方露骨地表现出不情愿。"
    },
    {
     "n": 8,
     "translation": "警察查明了骗子恶毒的手法。"
    }
   ]
  },
  "w2d6": {
   "items": [
    {
     "n": 1,
     "translation": "大部分人都赞成他的意见。"
    },
    {
     "n": 2,
     "translation": "这次价格大幅下调了。"
    },
    {
     "n": 3,
     "translation": "我坚决反对提高消费税。"
    },
    {
     "n": 4,
     "translation": "电脑在这10年里取得了惊人的进步。"
    },
    {
     "n": 5,
     "translation": "这一带到处都有便利店。"
    },
    {
     "n": 6,
     "translation": "糖稍微多放一点会更好吃。"
    },
    {
     "n": 7,
     "translation": "吵嘴的话，妻子压倒性地占上风。"
    },
    {
     "n": 8,
     "translation": "无论什么情况都可以来商量。"
    }
   ]
  },
  "w3d1": {
   "items": [
    {
     "n": 1,
     "translation": "连续下雨，房间里湿漉漉的。"
    },
    {
     "n": 2,
     "translation": "狗对着食物，口水直流。"
    },
    {
     "n": 3,
     "translation": "运费因运输公司而各不相同。"
    },
    {
     "n": 4,
     "translation": "蝴蝶在原野上翩翩飞舞。"
    },
    {
     "n": 5,
     "translation": "把零散的拼图拼好完成了。"
    },
    {
     "n": 6,
     "translation": "想能流利地读日语。"
    },
    {
     "n": 7,
     "translation": "合同没谈成，上司肯定会大发雷霆吧。"
    },
    {
     "n": 8,
     "translation": "原以为他一定会当选，他落选了实在是非常遗憾。"
    }
   ]
  },
  "w3d2": {
   "items": [
    {
     "n": 1,
     "translation": "他到处搬家。"
    },
    {
     "n": 2,
     "translation": "我时常来这家拉面店。"
    },
    {
     "n": 3,
     "translation": "对已经过去的事一直耿耿于怀也没用。"
    },
    {
     "n": 4,
     "translation": "想买那款热门游戏软件，到处找了，但哪里都卖光了。"
    },
    {
     "n": 5,
     "translation": "这份报告虽然有些地方写错了字，但内容很好。"
    },
    {
     "n": 6,
     "translation": "她虽然发着牢骚，还是勉勉强强地帮我干了活。"
    },
    {
     "n": 7,
     "translation": "现在去车站的话，能从容赶上10点的电车吧。"
    },
    {
     "n": 8,
     "translation": "他在一点一点地攒买房的钱。"
    }
   ]
  },
  "w3d3": {
   "items": [
    {
     "n": 1,
     "translation": "我一直以为「たばこ」这个词肯定是日语，原来不是啊。"
    },
    {
     "n": 2,
     "translation": "他爽快地承认了那是自己犯的罪。"
    },
    {
     "n": 3,
     "translation": "在灯光照射下，东京塔在夜空中清晰地浮现出来。"
    },
    {
     "n": 4,
     "translation": "她迅速站起来，把座位让给了老人。"
    },
    {
     "n": 5,
     "translation": "完全不懂新手机的用法。"
    },
    {
     "n": 6,
     "translation": "从今天起我坚决戒酒。"
    },
    {
     "n": 7,
     "translation": "玩完以后要把玩具收拾整齐。"
    },
    {
     "n": 8,
     "translation": "运动后出了一身大汗。"
    }
   ]
  },
  "w3d4": {
   "items": [
    {
     "n": 1,
     "translation": "她睡得很熟，一点也没有要醒的迹象。"
    },
    {
     "n": 2,
     "translation": "我至今还在用盒式录音机。"
    },
    {
     "n": 3,
     "translation": "虽然是新型号，价格并没有那么贵哦。"
    },
    {
     "n": 4,
     "translation": "刚开始会觉得别扭，但很快就会习惯的。"
    },
    {
     "n": 5,
     "translation": "妻子一天到晚都在发牢骚。"
    },
    {
     "n": 6,
     "translation": "突然被人从后面叫住，吓了一跳。"
    },
    {
     "n": 7,
     "translation": "最近的高中生手机片刻不离手。"
    },
    {
     "n": 8,
     "translation": "时隔30年回母校一看，曾经是校园的地方建起了一座大公寓。"
    }
   ]
  },
  "w3d5": {
   "items": [
    {
     "n": 1,
     "translation": "这个杯面比那边的拉面店好吃多了。"
    },
    {
     "n": 2,
     "translation": "他虽然什么都没说，但一脸很不情愿的样子。"
    },
    {
     "n": 3,
     "translation": "挠了被虫子叮的地方，结果更痒了。"
    },
    {
     "n": 4,
     "translation": "那位老奶奶年轻时想必是个美人吧。"
    },
    {
     "n": 5,
     "translation": "今天外面特别冷。"
    },
    {
     "n": 6,
     "translation": "头狠狠地撞在了架子角上。"
    },
    {
     "n": 7,
     "translation": "考题非常难，完全不会。"
    },
    {
     "n": 8,
     "translation": "上了年纪也能保持健康，这比什么都好啊。"
    }
   ]
  },
  "w3d6": {
   "items": [
    {
     "n": 1,
     "translation": "本以为他们夫妻和睦，看样子他们好像离婚了。"
    },
    {
     "n": 2,
     "translation": "即使做了手术，他恐怕也救不过来吧。"
    },
    {
     "n": 3,
     "translation": "咦，奇怪。说不定走错路了。"
    },
    {
     "n": 4,
     "translation": "队伍勉强通过了预选。"
    },
    {
     "n": 5,
     "translation": "对待客人请尽量面带笑容。"
    },
    {
     "n": 6,
     "translation": "非常抱歉，那本书不巧已经没有库存了。"
    },
    {
     "n": 7,
     "translation": "这是用了大量时令蔬菜的菜肴。"
    },
    {
     "n": 8,
     "translation": "我提了好几个方案，但全都没被采纳。"
    }
   ]
  },
  "w4d1": {
   "items": [
    {
     "n": 1,
     "translation": "渐渐上了年纪，能分辨事物的好坏了。"
    },
    {
     "n": 2,
     "translation": "全体人员都同意了田中的意见。"
    },
    {
     "n": 3,
     "translation": "他虽然面不改色，但内心并不平静。"
    },
    {
     "n": 4,
     "translation": "这是在拍卖会上买到的二手冰箱。"
    },
    {
     "n": 5,
     "translation": "这台电脑又小又轻，可以轻松携带。"
    },
    {
     "n": 6,
     "translation": "我想不出这封邮件的发件人是谁。"
    },
    {
     "n": 7,
     "translation": "全家人分工打扫了整个房子。"
    },
    {
     "n": 8,
     "translation": "就算领了工资，要付的钱太多，手头也剩不下多少。"
    }
   ]
  },
  "w4d2": {
   "items": [
    {
     "n": 1,
     "translation": "他总是把麻烦的事往后推。"
    },
    {
     "n": 2,
     "translation": "他的出生地是青森。"
    },
    {
     "n": 3,
     "translation": "他沉迷于游戏，跟他说话也心不在焉。"
    },
    {
     "n": 4,
     "translation": "发生了火灾，消防车出动了。"
    },
    {
     "n": 5,
     "translation": "已经用酱油提前调好味了，只要烤一下马上就能吃。"
    },
    {
     "n": 6,
     "translation": "在没有人的公园里发生了火灾。"
    },
    {
     "n": 7,
     "translation": "对询问的答复终于到了。"
    },
    {
     "n": 8,
     "translation": "来，鼓足干劲加油吧！"
    }
   ]
  },
  "w4d3": {
   "items": [
    {
     "n": 1,
     "translation": "日本的少子老龄化正在加剧。"
    },
    {
     "n": 2,
     "translation": "所有人共同的愿望就是健康。"
    },
    {
     "n": 3,
     "translation": "政府发表了紧急声明。"
    },
    {
     "n": 4,
     "translation": "在车里可以不在意别人的目光大声唱歌。"
    },
    {
     "n": 5,
     "translation": "关于那件事，目前正在研究。"
    },
    {
     "n": 6,
     "translation": "我打算带头完成改革。"
    },
    {
     "n": 7,
     "translation": "住房贷款压得我家开支很紧张。"
    },
    {
     "n": 8,
     "translation": "那个女演员人气走在了实力前面啊。"
    }
   ]
  },
  "w4d4": {
   "items": [
    {
     "n": 1,
     "translation": "因为暴风雨，电车时刻表整天都很混乱。"
    },
    {
     "n": 2,
     "translation": "这是面向商家的，所以不零售。"
    },
    {
     "n": 3,
     "translation": "事已至此，就算赌气也要把它完成给你看。"
    },
    {
     "n": 4,
     "translation": "趁工作的间隙，顺路去了喜欢的咖啡店。"
    },
    {
     "n": 5,
     "translation": "因为下大雪，暂缓了外出。"
    },
    {
     "n": 6,
     "translation": "他至今还没能离开父母自立。"
    },
    {
     "n": 7,
     "translation": "在湖里目击到了来历不明的生物。"
    },
    {
     "n": 8,
     "translation": "警察着手调查那个事件。"
    }
   ]
  },
  "w4d5": {
   "items": [
    {
     "n": 1,
     "translation": "今天演讲的主题是生态学。"
    },
    {
     "n": 2,
     "translation": "那个国家是世界上屈指可数的石油生产国。"
    },
    {
     "n": 3,
     "translation": "我代替父亲去市政府申请了护理保险。"
    },
    {
     "n": 4,
     "translation": "京都有很多传统的年度节庆活动。"
    },
    {
     "n": 5,
     "translation": "大学毕业以后就和他断了音信。"
    },
    {
     "n": 6,
     "translation": "为了公司的繁荣，世代交替恐怕不可避免。"
    },
    {
     "n": 7,
     "translation": "菠萝是夏威夷的特产。"
    },
    {
     "n": 8,
     "translation": "因为药物的副作用，头发掉了。"
    }
   ]
  },
  "w4d6": {
   "items": [
    {
     "n": 1,
     "translation": "认为下任社长会是田中专务的意见占优势。"
    },
    {
     "n": 2,
     "translation": "沿着河堤有一条路。"
    },
    {
     "n": 3,
     "translation": "在酒席上不小心说出了真心话。"
    },
    {
     "n": 4,
     "translation": "本年度的国家预算超过了上一年。"
    },
    {
     "n": 5,
     "translation": "启动了新项目。"
    },
    {
     "n": 6,
     "translation": "旅游团两周要走10个地方，日程非常紧张。"
    },
    {
     "n": 7,
     "translation": "那家银行一度被收归国有。"
    },
    {
     "n": 8,
     "translation": "悬崖崩塌，那座房子被大量泥沙掩埋了。"
    }
   ]
  },
  "w5d1": {
   "items": [
    {
     "n": 1,
     "translation": "他有前科，找工作恐怕很难吧。"
    },
    {
     "n": 2,
     "translation": "没有正当理由携带刀具是被禁止的。"
    },
    {
     "n": 3,
     "translation": "在公园里发现了一具身份不明的遗体。"
    },
    {
     "n": 4,
     "translation": "听说大地震要来了，先只带着随身物品去了避难所。"
    },
    {
     "n": 5,
     "translation": "他表面上是普通的上班族，其实是刑警。"
    },
    {
     "n": 6,
     "translation": "把旧车折价卖掉，买了新车。"
    },
    {
     "n": 7,
     "translation": "要推出新艺人，需要做各种事前疏通。"
    },
    {
     "n": 8,
     "translation": "你的工资扣掉税金后，到手就是这个金额。"
    }
   ]
  },
  "w5d2": {
   "items": [
    {
     "n": 1,
     "translation": "由许多小环连在一起的项链。"
    },
    {
     "n": 2,
     "translation": "和犯人预告的一样，罪行发生了。"
    },
    {
     "n": 3,
     "translation": "得到的报酬全体人员平分了。"
    },
    {
     "n": 4,
     "translation": "那个店员诚恳地接待了我。"
    },
    {
     "n": 5,
     "translation": "他向母亲坦白了自己偷东西的事。"
    },
    {
     "n": 6,
     "translation": "我们致力于建设与自然和谐的城市。"
    },
    {
     "n": 7,
     "translation": "那个女演员其实已经结婚的事，前几天公开了。"
    },
    {
     "n": 8,
     "translation": "他把因癌症住院期间写的手记整理出版了。"
    }
   ]
  },
  "w5d3": {
   "items": [
    {
     "n": 1,
     "translation": "在会议上阐述了新产品的必要性。"
    },
    {
     "n": 2,
     "translation": "这是忠实再现真品的模型。"
    },
    {
     "n": 3,
     "translation": "被父母说服，放弃了升学。"
    },
    {
     "n": 4,
     "translation": "在鱼市场采购了新鲜的海鲜。"
    },
    {
     "n": 5,
     "translation": "他是个认真、人品好的人。"
    },
    {
     "n": 6,
     "translation": "定期存款有了一点点利息。"
    },
    {
     "n": 7,
     "translation": "他一失败就总是找些难看的借口。"
    },
    {
     "n": 8,
     "translation": "最近，名称中带有\"信息\"二字的学院很多。"
    }
   ]
  },
  "w5d4": {
   "items": [
    {
     "n": 1,
     "translation": "她立志当歌手，来到了东京。"
    },
    {
     "n": 2,
     "translation": "即使上了年纪，他的手艺也没有退步。"
    },
    {
     "n": 3,
     "translation": "请注意不要损害健康。"
    },
    {
     "n": 4,
     "translation": "据说这次的失败由他承担全部责任。"
    },
    {
     "n": 5,
     "translation": "我公司的产品全部符合安全标准。"
    },
    {
     "n": 6,
     "translation": "这孩子有艺术才能。"
    },
    {
     "n": 7,
     "translation": "据说回收再利用制造东西，其实要消耗相当多的能源。"
    },
    {
     "n": 8,
     "translation": "我国过去也曾富有天然资源。"
    }
   ]
  },
  "w5d5": {
   "items": [
    {
     "n": 1,
     "translation": "被晚霞染得微红的天空很美。"
    },
    {
     "n": 2,
     "translation": "父亲好像领悟到了做菜的乐趣，每天都下厨。"
    },
    {
     "n": 3,
     "translation": "她每天都担心在异国生活的儿子的健康。"
    },
    {
     "n": 4,
     "translation": "我们队终于摆脱了最后一名。"
    },
    {
     "n": 5,
     "translation": "最近这个地区接连发生大地震。"
    },
    {
     "n": 6,
     "translation": "哥哥周六周日都玩麻将玩得很起劲。"
    },
    {
     "n": 7,
     "translation": "他违背父母的教诲，变成了不良少年。"
    },
    {
     "n": 8,
     "translation": "他把父亲积攒下来的财产接二连三地卖掉了。"
    }
   ]
  },
  "w5d6": {
   "items": [
    {
     "n": 1,
     "translation": "早上的电车按照非常密集的时刻表运行。"
    },
    {
     "n": 2,
     "translation": "股票买卖要自己承担责任。"
    },
    {
     "n": 3,
     "translation": "传单上的30日（周六）是错误的，正确的是30日（周日）。"
    },
    {
     "n": 4,
     "translation": "这张邮票将来可能会升值。"
    },
    {
     "n": 5,
     "translation": "强制关闭了死机的电脑。"
    },
    {
     "n": 6,
     "translation": "他好像下定决心参加知事选举了。"
    },
    {
     "n": 7,
     "translation": "亲眼目睹了事故现场，非常害怕。"
    },
    {
     "n": 8,
     "translation": "这是我公司开发的划时代新技术。"
    }
   ]
  },
  "w6d1": {
   "items": [
    {
     "n": 1,
     "translation": "他的笑话完全没人笑。"
    },
    {
     "n": 2,
     "translation": "把火腿夹在面包里吃了。"
    },
    {
     "n": 3,
     "translation": "一不小心说漏了嘴，把他的秘密泄露了。"
    },
    {
     "n": 4,
     "translation": "那时的经验和现在的自信是相连的。"
    },
    {
     "n": 5,
     "translation": "略微听到了她要结婚的传闻。"
    },
    {
     "n": 6,
     "translation": "开门时手一滑，把拿着的书掉了。"
    },
    {
     "n": 7,
     "translation": "他和她在户籍上是兄妹，但没有血缘关系。"
    },
    {
     "n": 8,
     "translation": "他家在我家门前道路的对面。"
    }
   ]
  },
  "w6d2": {
   "items": [
    {
     "n": 1,
     "translation": "为了在会议上不出现反对意见，事先做了疏通。"
    },
    {
     "n": 2,
     "translation": "这么晚还带着孩子到处跑，太没常识了。"
    },
    {
     "n": 3,
     "translation": "樱花花瓣随风飘了过来。"
    },
    {
     "n": 4,
     "translation": "这块肉还没有完全熟，请再烤一下。"
    },
    {
     "n": 5,
     "translation": "她哭着引起了大家的注意。"
    },
    {
     "n": 6,
     "translation": "他在英国是相当有名的作家。"
    },
    {
     "n": 7,
     "translation": "虽然没心情，但被上司邀请去喝酒就没法拒绝。（原书选项2和4均印作「通らない」）"
    },
    {
     "n": 8,
     "translation": "他的提案虽然合乎道理，但很难实现吧。"
    }
   ]
  },
  "w6d3": {
   "items": [
    {
     "n": 1,
     "translation": "我和他以牢固的友情联系在一起。"
    },
    {
     "n": 2,
     "translation": "结婚后的几年过着幸福的日子。"
    },
    {
     "n": 3,
     "translation": "努力有了结果，实验成功了。"
    },
    {
     "n": 4,
     "translation": "我可以挺起胸膛说，我对这部作品有信心。"
    },
    {
     "n": 5,
     "translation": "电脑死机，数据一瞬间就没了。"
    },
    {
     "n": 6,
     "translation": "要消除她的误解需要时间吧。"
    },
    {
     "n": 7,
     "translation": "一万日元的钞票在柏青哥上花掉了。"
    },
    {
     "n": 8,
     "translation": "那两家公司签订了合并的合同。"
    }
   ]
  },
  "w6d4": {
   "items": [
    {
     "n": 1,
     "translation": "一想到今后还要还贷款，心情就很沉重。"
    },
    {
     "n": 2,
     "translation": "如果小看这份工作，以后会很辛苦的。"
    },
    {
     "n": 3,
     "translation": "对他那样说非常不妥。"
    },
    {
     "n": 4,
     "translation": "摆脱了不景气，今后的经济前景很光明。"
    },
    {
     "n": 5,
     "translation": "下定决心要戒烟。"
    },
    {
     "n": 6,
     "translation": "听信了\"能大赚一笔\"的甜言蜜语，失去了全部财产。"
    },
    {
     "n": 7,
     "translation": "他头脑顽固，不会改变自己的意见吧。"
    },
    {
     "n": 8,
     "translation": "我公司会严肃对待这次事故，努力防止再次发生。"
    }
   ]
  },
  "w6d5": {
   "items": [
    {
     "n": 1,
     "translation": "漫长的人生中，有好的时候也有坏的时候，起起伏伏。"
    },
    {
     "n": 2,
     "translation": "今天的课特别难啊。"
    },
    {
     "n": 3,
     "translation": "离开酒店前往车站。"
    },
    {
     "n": 4,
     "translation": "去上学倒是可以，但交通费可不能小看。"
    },
    {
     "n": 5,
     "translation": "能杀死那种病原菌的新药被发明了。"
    },
    {
     "n": 6,
     "translation": "别总是对过去的事耿耿于怀了。"
    },
    {
     "n": 7,
     "translation": "警察跟踪了那个可疑的男人。"
    },
    {
     "n": 8,
     "translation": "应该是一个老实人不吃亏的社会。"
    }
   ]
  },
  "w6d6": {
   "items": [
    {
     "n": 1,
     "translation": "首相做了合乎情理的说明。"
    },
    {
     "n": 2,
     "translation": "工程有了很大进展。"
    },
    {
     "n": 3,
     "translation": "为了有个话题，去新开的餐厅吃了一次。"
    },
    {
     "n": 4,
     "translation": "推测出犯人后，开始了搜查。"
    },
    {
     "n": 5,
     "translation": "你素质好，应该很快就能参加比赛吧。"
    },
    {
     "n": 6,
     "translation": "成为一名合格医生的道路是很漫长的。"
    },
    {
     "n": 7,
     "translation": "高峰时段，乘客们争先恐后地上下电车。"
    },
    {
     "n": 8,
     "translation": "他做了碰毒品这种违背人道的事情。"
    }
   ]
  },
  "w7d1": {
   "items": [
    {
     "n": 1,
     "translation": "他作弊是很明显的。"
    },
    {
     "n": 2,
     "translation": "在会议上用电脑做了发表。"
    },
    {
     "n": 3,
     "translation": "这是利用生物技术培育的抗虫害蔬菜。"
    },
    {
     "n": 4,
     "translation": "要是被公司裁员了怎么办。"
    },
    {
     "n": 5,
     "translation": "他非常没有时间观念。"
    },
    {
     "n": 6,
     "translation": "环保车使用了很多高科技技术。"
    },
    {
     "n": 7,
     "translation": "虽然是不错的公寓，但交通不便成了障碍，没有人租。"
    },
    {
     "n": 8,
     "translation": "好莱坞明星的片酬非常高。"
    }
   ]
  },
  "w7d2": {
   "items": [
    {
     "n": 1,
     "translation": "她的长相和声音差距很大啊。"
    },
    {
     "n": 2,
     "translation": "泡沫经济崩溃，经济陷入低迷。"
    },
    {
     "n": 3,
     "translation": "穿休闲一点的衣服去可以吗？"
    },
    {
     "n": 4,
     "translation": "这是关系到冠军的最后一场比赛，压力相当大。"
    },
    {
     "n": 5,
     "translation": "安保措施已经做得很充分了。"
    },
    {
     "n": 6,
     "translation": "买了一条松软、手感柔和的毛毯。"
    },
    {
     "n": 7,
     "translation": "新型车辆的设计更加简洁利落了。"
    },
    {
     "n": 8,
     "translation": "因为业绩指标太重，辞掉了销售的工作。"
    }
   ]
  },
  "w7d3": {
   "items": [
    {
     "n": 1,
     "translation": "一提醒他，他突然就发火了。"
    },
    {
     "n": 2,
     "translation": "把文字处理软件从1.0升级到了2.0。"
    },
    {
     "n": 3,
     "translation": "量了三围，定做了一套西装。"
    },
    {
     "n": 4,
     "translation": "可能是因为我有很多不幸的经历，变得没法积极地看待事情了。"
    },
    {
     "n": 5,
     "translation": "杂志上刊登了她明年春天将和比她小两岁的医生结婚的报道。"
    },
    {
     "n": 6,
     "translation": "我在休息日做用电脑的副业。"
    },
    {
     "n": 7,
     "translation": "购买的顾客还可以额外获得优惠哦。"
    },
    {
     "n": 8,
     "translation": "同样的书重复买了两本。"
    }
   ]
  },
  "w7d4": {
   "items": [
    {
     "n": 1,
     "translation": "放了烟花。"
    },
    {
     "n": 2,
     "translation": "被强行催讨了借款。"
    },
    {
     "n": 3,
     "translation": "昨天在那条街上进行了酒驾检查。"
    },
    {
     "n": 4,
     "translation": "从北海道订购了很有名的巧克力点心。"
    },
    {
     "n": 5,
     "translation": "向朋友倾诉了烦恼。"
    },
    {
     "n": 6,
     "translation": "一个中年女性插队进来了。"
    },
    {
     "n": 7,
     "translation": "那名选手因为惹出事件，被迫退役了。"
    },
    {
     "n": 8,
     "translation": "芝麻油使这道菜更加美味。"
    }
   ]
  },
  "w7d5": {
   "items": [
    {
     "n": 1,
     "translation": "首相中途放弃了政权。"
    },
    {
     "n": 2,
     "translation": "衣服被突出来的钉子刮破了。"
    },
    {
     "n": 3,
     "translation": "销售额不断下降。"
    },
    {
     "n": 4,
     "translation": "被叫了名字，回头一看，原来是山田。"
    },
    {
     "n": 5,
     "translation": "把口香糖扔进了嘴里。"
    },
    {
     "n": 6,
     "translation": "半夜偷偷溜出家门去玩了。"
    },
    {
     "n": 7,
     "translation": "他埋头练习吉他。"
    },
    {
     "n": 8,
     "translation": "这一带是填海造出来的土地。"
    }
   ]
  },
  "w7d6": {
   "items": [
    {
     "n": 1,
     "translation": "他坚持说自己绝对没做过。"
    },
    {
     "n": 2,
     "translation": "遭遇诈骗，店被人霸占了。"
    },
    {
     "n": 3,
     "translation": "两只海豚亲密地依偎着游泳。"
    },
    {
     "n": 4,
     "translation": "一开店，大批顾客蜂拥而至。"
    },
    {
     "n": 5,
     "translation": "他不顾医生的忠告参加了比赛。"
    },
    {
     "n": 6,
     "translation": "没有顾客，生意就维持不下去。"
    },
    {
     "n": 7,
     "translation": "终于做完了一整本习题集。"
    },
    {
     "n": 8,
     "translation": "转换一下心情，好，再从头开始吧。"
    }
   ]
  }
 }
}