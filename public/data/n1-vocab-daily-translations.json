{
 "version": 1,
 "vocab": {
  "w1d1": {
   "items": [
    {
     "n": 1,
     "translation": "我丈夫花钱非常大手大脚。"
    },
    {
     "n": 2,
     "translation": "他在时间上有点散漫。"
    },
    {
     "n": 3,
     "translation": "她虽然是大明星，却是个非常坦率随和的人。"
    },
    {
     "n": 4,
     "translation": "豪华而有气派、光彩夺目的宝石。"
    },
    {
     "n": 5,
     "translation": "太贪财的人会被讨厌。"
    },
    {
     "n": 6,
     "translation": "那个店员对谁都和蔼可亲。"
    },
    {
     "n": 7,
     "translation": "她是前途有望的新人女演员。"
    },
    {
     "n": 8,
     "translation": "他有着健壮的身体。"
    }
   ]
  },
  "w1d2": {
   "items": [
    {
     "n": 1,
     "translation": "差点没赶上电车，很着急。"
    },
    {
     "n": 2,
     "translation": "山田老师一生气就非常可怕哦。"
    },
    {
     "n": 3,
     "translation": "非常盼望去旅行的日子。"
    },
    {
     "n": 4,
     "translation": "顾虑邻居，没法练习乐器。"
    },
    {
     "n": 5,
     "translation": "梅雨季节总是下雨，令人郁闷。"
    },
    {
     "n": 6,
     "translation": "这么简单的问题都做错了，真是太丢人了。"
    },
    {
     "n": 7,
     "translation": "这台电脑不需要麻烦的布线。"
    },
    {
     "n": 8,
     "translation": "他才是适合当总统的人物。"
    }
   ]
  },
  "w1d3": {
   "items": [
    {
     "n": 1,
     "translation": "好好泡在热水里，泡到肩膀吧。"
    },
    {
     "n": 2,
     "translation": "为了避开窜到车前的猫，结果撞上了电线杆。"
    },
    {
     "n": 3,
     "translation": "不能从道口的栏杆下面钻过去。"
    },
    {
     "n": 4,
     "translation": "那是我小时候经常哼的歌。"
    },
    {
     "n": 5,
     "translation": "用海苔把米饭包起来吃。"
    },
    {
     "n": 6,
     "translation": "被批评的学生低着头哭了。"
    },
    {
     "n": 7,
     "translation": "累了，可以在沙发上躺一会儿吗？"
    },
    {
     "n": 8,
     "translation": "假日里摆弄庭院是我的爱好。"
    }
   ]
  },
  "w1d4": {
   "items": [
    {
     "n": 1,
     "translation": "我家的狗最亲近妈妈。"
    },
    {
     "n": 2,
     "translation": "和教练闹翻的那名选手，最终被迫退出了。"
    },
    {
     "n": 3,
     "translation": "谁都不袒护我。"
    },
    {
     "n": 4,
     "translation": "她对丈夫尽心尽力。"
    },
    {
     "n": 5,
     "translation": "这部漫画的主人公最后终于收拾了坏人。"
    },
    {
     "n": 6,
     "translation": "他是被父母娇生惯养长大的。"
    },
    {
     "n": 7,
     "translation": "恶作剧被人向老师告了状。"
    },
    {
     "n": 8,
     "translation": "感冒加重，闹到了住院的地步。"
    }
   ]
  },
  "w1d5": {
   "items": [
    {
     "n": 1,
     "translation": "浴室里长霉了。"
    },
    {
     "n": 2,
     "translation": "请不要给猴子喂食。"
    },
    {
     "n": 3,
     "translation": "用窗帘挡住了光线。"
    },
    {
     "n": 4,
     "translation": "请把切好的洋葱用水泡一下。"
    },
    {
     "n": 5,
     "translation": "因为太热，把系着的领带松开了。"
    },
    {
     "n": 6,
     "translation": "手一滑，爆米花撒了一地。"
    },
    {
     "n": 7,
     "translation": "眼看要吵起来，赶紧岔开了话题。"
    },
    {
     "n": 8,
     "translation": "我违背了和他定下的约定。"
    }
   ]
  },
  "w1d6": {
   "items": [
    {
     "n": 1,
     "translation": "妈妈去医院，我必须陪着。"
    },
    {
     "n": 2,
     "translation": "鱼刺卡在喉咙里了。"
    },
    {
     "n": 3,
     "translation": "因为中暑，意识模糊不清。"
    },
    {
     "n": 4,
     "translation": "被虫子叮的手指肿成了这样。"
    },
    {
     "n": 5,
     "translation": "也许是累了，眼睛发花看不清楚。"
    },
    {
     "n": 6,
     "translation": "吃了药以后，疼痛缓解了不少。"
    },
    {
     "n": 7,
     "translation": "饿得头晕眼花。"
    },
    {
     "n": 8,
     "translation": "病情加速恶化，他终于陷入了昏迷。"
    }
   ]
  },
  "w2d1": {
   "items": [
    {
     "n": 1,
     "translation": "在车站换乘电车时不知所措。"
    },
    {
     "n": 2,
     "translation": "焦点没对上的模糊照片。"
    },
    {
     "n": 3,
     "translation": "他自以为很有才能。"
    },
    {
     "n": 4,
     "translation": "那座建筑的构造相当讲究。"
    },
    {
     "n": 5,
     "translation": "等了1个小时公交车还没来，等累了。"
    },
    {
     "n": 6,
     "translation": "他为自己的失败而叹息。"
    },
    {
     "n": 7,
     "translation": "梦想成真，成为了职业棒球选手！"
    },
    {
     "n": 8,
     "translation": "少年谎报年龄买了香烟。"
    }
   ]
  },
  "w2d2": {
   "items": [
    {
     "n": 1,
     "translation": "最近好像流行尖头鞋。"
    },
    {
     "n": 2,
     "translation": "门嘎吱嘎吱地响，很吵。"
    },
    {
     "n": 3,
     "translation": "这道炖菜里的牛肉软得像要化了，非常好吃。"
    },
    {
     "n": 4,
     "translation": "妈妈帮我把破了洞的袜子补好了。"
    },
    {
     "n": 5,
     "translation": "挥了球棒，但球只是擦了一下，没有飞出去。"
    },
    {
     "n": 6,
     "translation": "也许是眼镜度数不合适，字模模糊糊看不清楚。"
    },
    {
     "n": 7,
     "translation": "这块布经过了防水加工。"
    },
    {
     "n": 8,
     "translation": "因为蛀牙，脸肿了。"
    }
   ]
  },
  "w2d3": {
   "items": [
    {
     "n": 1,
     "translation": "他的名次颠覆了周围人的预测，最终是第3名。"
    },
    {
     "n": 2,
     "translation": "婚礼致辞中，千篇一律的客套话一个接一个。"
    },
    {
     "n": 3,
     "translation": "如果左右平衡的话，应该能笔直前进。"
    },
    {
     "n": 4,
     "translation": "他好像是靠吃山里的野草和树果熬过了饥饿。"
    },
    {
     "n": 5,
     "translation": "那一瞬间，云层断开，阳光照了下来。"
    },
    {
     "n": 6,
     "translation": "出轨被妻子发现了。"
    },
    {
     "n": 7,
     "translation": "被醉汉纠缠，打起架来了。"
    },
    {
     "n": 8,
     "translation": "那个村子的人口不断减少，最终连小学也没有了。"
    }
   ]
  },
  "w2d4": {
   "items": [
    {
     "n": 1,
     "translation": "那位演员上了年纪以后，演技变得非常沉稳老练。"
    },
    {
     "n": 2,
     "translation": "那名足球选手用娴熟的技术让观众着迷。"
    },
    {
     "n": 3,
     "translation": "开局明明很顺利，最后却精疲力尽，落到了最后一名。"
    },
    {
     "n": 4,
     "translation": "她总是戴着华丽耀眼的首饰。"
    },
    {
     "n": 5,
     "translation": "为顾客提供细致周到的服务。"
    },
    {
     "n": 6,
     "translation": "经济正在缓慢恢复。"
    },
    {
     "n": 7,
     "translation": "派对在和睦的气氛中进行着。"
    },
    {
     "n": 8,
     "translation": "夫妻和睦，过着幸福的生活。"
    }
   ]
  },
  "w2d5": {
   "items": [
    {
     "n": 1,
     "translation": "开车兜风前仔细检查了车。"
    },
    {
     "n": 2,
     "translation": "虽说是独栋房子，其实是只有两个房间的小房子。"
    },
    {
     "n": 3,
     "translation": "养育孩子绝不是件容易的事。"
    },
    {
     "n": 4,
     "translation": "电话里传来了令人毛骨悚然的声音。"
    },
    {
     "n": 5,
     "translation": "太难看了，别在电车里化妆。"
    },
    {
     "n": 6,
     "translation": "出生一周就会死去的、生命短暂的虫子。"
    },
    {
     "n": 7,
     "translation": "我向朋友借钱，结果对方露骨地表现出不情愿。"
    },
    {
     "n": 8,
     "translation": "警察查明了骗子恶毒的手法。"
    }
   ]
  },
  "w2d6": {
   "items": [
    {
     "n": 1,
     "translation": "大部分人都赞成他的意见。"
    },
    {
     "n": 2,
     "translation": "这次价格大幅下调了。"
    },
    {
     "n": 3,
     "translation": "我坚决反对提高消费税。"
    },
    {
     "n": 4,
     "translation": "电脑在这10年里取得了惊人的进步。"
    },
    {
     "n": 5,
     "translation": "这一带到处都有便利店。"
    },
    {
     "n": 6,
     "translation": "糖稍微多放一点会更好吃。"
    },
    {
     "n": 7,
     "translation": "吵嘴的话，妻子压倒性地占上风。"
    },
    {
     "n": 8,
     "translation": "无论什么情况都可以来商量。"
    }
   ]
  }
 }
}