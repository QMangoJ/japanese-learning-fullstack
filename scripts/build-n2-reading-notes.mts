// Builds app/data/reading-n2/notes/wXdY.ts from the hand-written
// app/data/reading-n2/notes/src/wXdY.txt files and checks every sentence
// against the passage text it explains.
//
// Source format (one sentence per record, records separated by blank lines):
//   > 日本語の{文|ぶん}。                 sentence, furigana markup as in the passage
//   = 中文翻译
//   | 结构行（行首每两个空格缩进一级）
//   + 句型 | N2 | 接续 | 意思 | 本句中的作用 | 相似句型(可省)
//   * 単語 | かな | 中文 | N2
// Lines starting with # are comments.
import { readFileSync, readdirSync, writeFileSync } from "node:fs";
import { join } from "node:path";
import { readingDays } from "../app/data/reading-n2/index.ts";
import type { DayNotes, SentenceNote, JlptLevel } from "../app/data/reading-n2/notes/types.ts";

const dir = join(import.meta.dirname, "../app/data/reading-n2/notes");
const RUBY = /\{([^{}|]+)\|([^{}|]+)\}/g;
const plain = (s: string) => s.replace(RUBY, "$1");
const norm = (s: string) => plain(s).replace(/[\s　]/g, "");
const LV = /^N[1-5]$/;

function blockTexts(day: (typeof readingDays)[number]): string[] {
	const groups = [day.renshu?.blocks, day.mondai?.blocks, ...(day.practice?.groups.map((g) => g.blocks) ?? [])];
	const out: string[] = [];
	for (const blocks of groups) {
		for (const block of blocks ?? []) {
			if (block.type === "list") out.push(...block.items.map((i) => i.jp));
			else if ("jp" in block && typeof block.jp === "string" && block.type !== "figure") out.push(block.jp);
		}
	}
	return out;
}

function parse(file: string, text: string): SentenceNote[] {
	const notes: SentenceNote[] = [];
	let cur: SentenceNote | null = null;
	text.split("\n").forEach((raw, i) => {
		const line = raw.replace(/\s+$/, "");
		const where = `${file}:${i + 1}`;
		if (!line.trim() || line.startsWith("#")) return;
		const tag = line[0];
		const body = line.slice(1).replace(/^ /, "");
		if (tag === ">") {
			cur = { jp: body.trim(), cn: "", structure: [], grammar: [], words: [] };
			notes.push(cur);
			return;
		}
		if (!cur) throw new Error(`${where}: content before first ">" line`);
		if (tag === "=") cur.cn = (cur.cn ? `${cur.cn}` : "") + body.trim();
		else if (tag === "|") {
			const depth = Math.floor((body.match(/^ */)?.[0].length ?? 0) / 2);
			cur.structure.push({ depth: Math.min(depth, 4), text: body.trim() });
		} else if (tag === "+") {
			const [pattern, lv, form, meaning, here, similar] = body.split(/\s*\|\s*/).map((s) => s.trim());
			if (!pattern || !form || !meaning || !here) throw new Error(`${where}: grammar needs pattern | lv | form | meaning | here`);
			if (lv && !LV.test(lv)) throw new Error(`${where}: bad level ${lv}`);
			cur.grammar.push({ pattern, ...(lv ? { lv: lv as JlptLevel } : {}), form, meaning, here, ...(similar ? { similar } : {}) });
		} else if (tag === "*") {
			const [jp, kana, cn, lv] = body.split(/\s*\|\s*/).map((s) => s.trim());
			if (!jp || !cn) throw new Error(`${where}: word needs jp | kana | cn | lv`);
			if (lv && !LV.test(lv)) throw new Error(`${where}: bad level ${lv}`);
			cur.words.push({ jp, ...(kana ? { kana } : {}), cn, ...(lv ? { lv: lv as JlptLevel } : {}) });
		} else throw new Error(`${where}: unknown line tag "${tag}"`);
	});
	return notes;
}

const loaders: string[] = [];
let total = 0;
for (const file of readdirSync(join(dir, "src")).filter((f) => /^w\d+d\d+\.txt$/.test(f)).sort()) {
	const id = file.replace(".txt", "");
	const [, w, d] = id.match(/^w(\d+)d(\d+)$/)!.map(Number);
	const day = readingDays.find((x) => x.week === w && x.day === d);
	if (!day) throw new Error(`${file}: no such reading day`);
	const blocks = blockTexts(day);
	const notes = parse(file, readFileSync(join(dir, "src", file), "utf8"));
	const out: DayNotes = {};
	// Sentences are listed in passage order; consume each block left to right.
	const progress = new Map<string, string>();
	for (const note of notes) {
		if (!note.cn) throw new Error(`${file}: missing translation for ${note.jp}`);
		const s = norm(note.jp);
		const block = blocks.find((b) => {
			const rest = progress.get(b) ?? norm(b);
			return rest.startsWith(s);
		}) ?? blocks.find((b) => norm(b).includes(s));
		if (!block) throw new Error(`${file}: sentence not found in passage: ${note.jp}`);
		const rest = progress.get(block) ?? norm(block);
		progress.set(block, rest.startsWith(s) ? rest.slice(s.length) : rest);
		(out[plain(block)] ??= []).push(note);
		total++;
	}
	const missing = [...progress.entries()].filter(([, rest]) => rest.length > 0);
	for (const [block, rest] of missing) console.warn(`${file}: block not fully covered (left: ${rest}) in ${plain(block).slice(0, 30)}…`);
	writeFileSync(
		join(dir, `${id}.ts`),
		`// Generated by scripts/build-n2-reading-notes.mts from src/${file}. Do not edit by hand.\nimport type { DayNotes } from "./types";\n\nexport const notes: DayNotes = ${JSON.stringify(out, null, "\t")};\n`,
	);
	loaders.push(`\t"${w}-${d}": () => import("./${id}").then((m) => m.notes),`);
	console.log(`${id}: ${notes.length} sentences in ${Object.keys(out).length} blocks`);
}
writeFileSync(
	join(dir, "index.ts"),
	`// Generated by scripts/build-n2-reading-notes.mts. Each day loads on demand.\nimport type { DayNotes } from "./types";\n\nexport type { DayNotes, SentenceNote } from "./types";\n\nconst loaders: Record<string, () => Promise<DayNotes>> = {\n${loaders.join("\n")}\n};\n\nexport function hasN2ReadingNotes(week: number, day: number): boolean {\n\treturn \`\${week}-\${day}\` in loaders;\n}\n\nexport function loadN2ReadingNotes(week: number, day: number): Promise<DayNotes> | undefined {\n\treturn loaders[\`\${week}-\${day}\`]?.();\n}\n`,
);
console.log(`total: ${total} sentences`);
